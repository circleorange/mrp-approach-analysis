  author = {Saber, Takfarinas and Gandibleux, Xavier and O'Neill, Michael and Murphy, Liam and Ventresque, Anthony},
  year = {2020},
  month = feb,
  journal = {Journal of Heuristics},
  volume = {26},
  number = {1},
  pages = {119--150},
  issn = {1381-1231, 1572-9397},
  doi = {10.1007/s10732-019-09427-8},
  urldate = {2025-06-28},
  abstract = {This paper consists of a comparative study of heuristics and exact algorithms for the multi-objective machine reassignment problem. Given the common intuition that the problem is too complicated for exact resolutions, all previous works have focused on various (meta)heuristics such as First-Fit, GRASP, NSGA-II or PLS. In this paper, we show that the state-of-art solution to the single objective formulation of the problem (CBLNS) and the classical multi-objective solutions fail to bridge the gap between the number, quality and variety of solutions. Hybrid metaheuristics, on the other hand, have proven to be more effective and efficient to address the problem---but as there has never been any study of an exact resolution, it was difficult to qualify their results. In this paper, we present the most relevant techniques used to address the problem, and we compare them to an exact resolution ( -Constraints). We show that the problem is indeed large and constrained (we ran our algorithm for 30 days on a powerful node of a supercomputer and did not get the final solution for most instances of our problem) but that a metaheuristic (GeNePi) obtains acceptable results: more (+ 188\%) solutions than the exact resolution and a little more than half (52\%) the hypervolume (measure of quality of the solution set).},
  langid = {english},
  keywords = {/unread},
  file = {C:\Users\PiotrBielski(AIA)\OneDrive - Applied Intelligence Analytics Limited\Documents\zotero_citations\Machine Reassignment\Applications\Saber et al. - 2020 - A comparative study of multi-objective machine reassignment algorithms for data centres.pdf}
}

