  author = {Butelle, Franck and Alfandari, Laurent and Coti, Camille and Finta, Lucian and L{\'e}tocart, Lucas and Plateau, G{\'e}rard and Roupin, Fr{\'e}d{\'e}ric and Rozenknop, Antoine and Calvo, Roberto Wolfler},
