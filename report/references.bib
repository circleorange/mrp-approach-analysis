  booktitle = {Integration of {{AI}} and {{OR Techniques}} in {{Constraint Programming}} for {{Combinatorial Optimization Problems}}},
  author = {Malitsky, Yuri and Mehta, Deepak and O'Sullivan, Barry and Simonis, Helmut},
