{
    "version": "2.0.0",
    "tasks": [
        { "label": "VNS: Build",
            "type": "shell",
            "command": "make",
            "args": ["clean", "&&", "make"],
            "options": {
                "cwd": "${workspaceFolder}/gavra/Releasegcc"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "group": "gavra"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the C++ S41 algorithm"
        },
        { "label": "VNS: Test Run (a1_4, 10s)",
            "type": "shell",
            "command": "./machineReassignment",
            "args": [
                "-p", "${workspaceFolder}/jask/data/A/model_a1_4.txt",
                "-i", "${workspaceFolder}/jask/data/A/assignment_a1_4.txt",
                "-o", "test_output.txt",
                "-t", "10",
                "-s", "12345"
            ],
            "options": {
                "cwd": "${workspaceFolder}/gavra/Releasegcc"
            },
            "group": "test",
            "dependsOn": "VNS: Build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "gavra"
            },
            "problemMatcher": [],
            "detail": "Run VNS algorithm for quick 10-seconds"
        },
        { "label": "VNS: Full Run (a1_4, 300s)",
            "type": "shell",
            "command": "./run_analysis.sh",
            "args": ["a1_4", "300", "42"],
            "options": {
                "cwd": "${workspaceFolder}/gavra"
            },
            "group": "test",
            "dependsOn": "VNS: Build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "gavra"
            },
            "problemMatcher": [],
            "detail": "Run VNS algorithm on dataset a1_4 for 5 minutes"
        },
        { "label": "HC-LNS: Build JAR",
            "type": "shell",
            "command": "ant",
            "args": ["jar"],
            "options": {
                "cwd": "${workspaceFolder}/jask"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "group": "jask"
            },
            "problemMatcher": [],
            "detail": "Build J12 algorithm (HC-LNS) JAR file"
        },
        { "label": "HC-LNS: Compile Only",
            "type": "shell",
            "command": "ant",
            "args": ["compile"],
            "options": {
                "cwd": "${workspaceFolder}/jask"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "group": "jask"
            },
            "problemMatcher": [],
            "detail": "Compile Java sources without creating JAR"
        },
        { "label": "HC-LNS: Full Run (a1_4, 300s)",
            "type": "shell",
            "command": "java",
            "args": [
                "-Djava.library.path=/opt/ibm/ILOG/CPLEX_Studio2211/cplex/bin/x86-64_linux",
                "-jar",
                "build/jar/roadef.jar",
                "-conf",
                "conf/hc_lnshc.conf",
                "-p",
                "data/A/model_a1_4.txt",
                "-i",
                "data/A/assignment_a1_4.txt",
                "-o",
                "new_assignment_a1_4.txt",
                "-t",
                "300"
            ],
            "options": {
                "cwd": "${workspaceFolder}/jask",
                "env": {
                    "LD_LIBRARY_PATH": "/opt/ibm/ILOG/CPLEX_Studio2211/cplex/bin/x86-64_linux:${env:LD_LIBRARY_PATH}"
                }
            },
            "group": "test",
            "dependsOn": "HC-LNS: Build JAR",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "jask"
            },
            "problemMatcher": [],
            "detail": "Run HC-LNSHC algorithm with CPLEX solver (5 minutes)"
        },
        { "label": "HC-LNS: Test Run (a1_1, 10s)",
            "type": "shell",
            "command": "java",
            "args": [
                "-Djava.library.path=/opt/ibm/ILOG/CPLEX_Studio2211/cplex/bin/x86-64_linux",
                "-jar",
                "build/jar/roadef.jar",
                "-conf",
                "conf/hc_lnshc.conf",
                "-p",
                "data/A/model_a1_1.txt",
                "-i",
                "data/A/assignment_a1_1.txt",
                "-o",
                "test_assignment_a1_1.txt",
                "-t",
                "10"
            ],
            "options": {
                "cwd": "${workspaceFolder}/jask",
                "env": {
                    "LD_LIBRARY_PATH": "/opt/ibm/ILOG/CPLEX_Studio2211/cplex/bin/x86-64_linux:${env:LD_LIBRARY_PATH}"
                }
            },
            "group": "test",
            "dependsOn": "HC-LNS : Build JAR",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "jask"
            },
            "problemMatcher": [],
            "detail": "Test run HC-LNSHC algorithm for 10 seconds"
        },
        { "label": "HC-LNS: Clean Build",
            "type": "shell",
            "command": "ant",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}/jask"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "group": "jask"
            },
            "problemMatcher": [],
            "detail": "Clean Java build directory"
        },
        { "label": "CP-LNS: Build Algorithm",
            "type": "shell",
            "command": "make",
            "args": ["clean", "&&", "make", "roadef"],
            "options": {
                "cwd": "${workspaceFolder}/mehta/cblns"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "group": "mehta"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build CP-LNS algorithm (C language)"
        },
        { "label": "CP-LNS: Test Run (a1_1, 10s)",
            "type": "shell",
            "command": "./machineReassignment",
            "args": [
                "-p", "${workspaceFolder}/jask/data/A/model_a1_1.txt",
                "-i", "${workspaceFolder}/jask/data/A/assignment_a1_1.txt",
                "-t", "10"
            ],
            "options": {
                "cwd": "${workspaceFolder}/mehta/cblns"
            },
            "group": "test",
            "dependsOn": "CP-LNS: Build Algorithm",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "mehta"
            },
            "problemMatcher": [],
            "detail": "Run CP-LNS algorithm with a quick 10-second test"
        },
        { "label": "CP-LNS: Full Run (a1_4, 300s)",
            "type": "shell",
            "command": "./machineReassignment",
            "args": [
                "-p", "${workspaceFolder}/jask/data/A/model_a1_4.txt",
                "-i", "${workspaceFolder}/jask/data/A/assignment_a1_4.txt",
                "-t", "300"
            ],
            "options": {
                "cwd": "${workspaceFolder}/mehta/cblns"
            },
            "group": "test",
            "dependsOn": "CP-LNS: Build Algorithm",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "mehta"
            },
            "problemMatcher": [],
            "detail": "Run CP-LNS algorithm on dataset a1_4 for 5 minutes"
        },
        { "label": "Test Run All Algorithms",
            "type": "shell",
            "command": "echo",
            "args": ["Starting comparison between GAVRA S41, JASK J12, and MEHTA CB-LNS algorithms..."],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "dependsOrder": "sequence",
            "dependsOn": [
                "VNS: Test Run",
                "HC-LNS: Test Run",
                "CP-LNS: Test Run"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "comparison"
            },
            "problemMatcher": [],
            "detail": "Test run all three algorithms sequentially for comparison"
        }
    ]
}
